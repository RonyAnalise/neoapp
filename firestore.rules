rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'ronycvcsales@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOperator() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'operator')
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny catch-all: Bloqueia qualquer rota não mapeada explicitamente
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins: Somente super administradores podem gerenciar permissões administrativas
    match /admins/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Usuários: Apenas o próprio usuário autenticado ou administradores têm acesso ao perfil
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Clientes: Dados confidenciais de consumidores (CPF/CNPJ, endereços e medidores)
    match /clientes/{clienteId} {
      allow read: if isSignedIn();
      allow create, update: if isOperator() || isAdmin();
      allow delete: if isAdmin();
    }

    // Empresa: Dados institucionais públicos para validação de faturas
    match /empresa/{empresaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Configurações e tarifas do sistema
    match /configuracoes/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Histórico de Tarifas
    match /historico_tarifas/{tarifaId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Leituras de medidores (inclusive leituras com fotos e IA)
    match /leituras/{leituraId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isOperator() || isAdmin() || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['meterPhotoBase64', 'meterPhotoDeletedAt', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // Faturas: Documentos financeiros de consumo e economia
    match /faturas/{faturaId} {
      allow read, write: if true;
    }

    // Pagamentos: Registros de quitação financeira
    match /pagamentos/{pagamentoId} {
      allow read, write: if true;
    }

    // Auditoria: Trilha de auditoria (permite gravação transparente)
    match /auditoria/{auditoriaId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Taxas Coelba (Comprovantes de taxas quitadas da concessionária)
    match /taxas_coelba/{taxaId} {
      allow read, write: if true;
    }

    // Notificações para o Portal do Cliente
    match /notificacoes/{notificacaoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Assinaturas Push de Dispositivos (Web Push)
    match /push_subscriptions/{subId} {
      allow read: if isAdmin();
      allow create, update: if request.resource.data.endpoint is string && request.resource.data.keys is map;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.clientId == request.auth.uid);
    }
  }
}
