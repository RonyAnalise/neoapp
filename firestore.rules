rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'ronycvcsales@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins index
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Clientes
    match /clientes/{clienteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Empresa
    match /empresa/{empresaId} {
      allow read: if true; // Permite visualização pública da fatura se compartilhada
      allow write: if isAdmin();
    }

    // Configurações
    match /configuracoes/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Histórico de Tarifas
    match /historico_tarifas/{tarifaId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Leituras
    match /leituras/{leituraId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Faturas
    match /faturas/{faturaId} {
      allow read: if true; // Permite visualização por link direto de fatura
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Pagamentos
    match /pagamentos/{pagamentoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Auditoria
    match /auditoria/{auditoriaId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // Auditoria é somente inclusão (imutável)
    }

    // Taxas Coelba (Taxas Quitadas)
    match /taxas_coelba/{taxaId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}
